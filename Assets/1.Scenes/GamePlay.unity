  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIHoverTooltip
  tooltipTitle: Chill
  tooltipText: "Slows enemy movement speed with stacking frost.\r\n\r\nChance: chance
    to apply Chill on hit  \r\nSlow: x% movement speed reduction per stack  \r\nDuration:
    each stack lasts 5s but refreshes on new application\r\nStacks: up to 6 stacks
    \r\n\r\nChill reduces enemy mobility, making them easier to control and kite."
  tooltipPanel: {fileID: 1265542261}
  tooltipAnchor: {fileID: 1369682479}
  tooltipMeasureRect: {fileID: 1751072472}
  preferredSide: 1
