  m_Script: {fileID: 11500000, guid: f6c0eb409165c924f9a7b2ddb5525efe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIHoverTooltip
  tooltipTitle: Burn
  tooltipText: "Applies damage over time from fire attacks (physical, magic, or true
    on the hit, when your weapon or element is Fire).\n\r\nChance: chance to add
    a burn stack on hit  \r\nMultiplier: increases total Burn damage (this applies
    to each tick and combust)  \r\nDuration: How long burn lasts; any fire hit refreshes
    this timer  \r\nStacks: Do not increase tick damage\u2014they build toward combust.
    At 3 stacks, combust deals 10 seconds of burn as magical damage, then clears.
    Weaker hits never reduce tick damage."
  tooltipPanel: {fileID: 1265542261}
  tooltipAnchor: {fileID: 1369682479}
  tooltipMeasureRect: {fileID: 1751072472}
  preferredSide: 1
