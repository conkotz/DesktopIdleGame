  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIHoverTooltip
  tooltipTitle: Bleed
  tooltipText: "Applies a damage over time effect from physical attacks.\n\nChance:
    chance to apply Bleed on hit  \nMultiplier: increases total Bleed damage  \nDuration:
    how long Bleed lasts  \n\nBleed damage is not affected by armor or crits once
    applied but the initial hit that applies bleed is. Only applies a single stack."
  tooltipPanel: {fileID: 1265542261}
  tooltipAnchor: {fileID: 1369682479}
  tooltipMeasureRect: {fileID: 1751072472}
  preferredSide: 1
