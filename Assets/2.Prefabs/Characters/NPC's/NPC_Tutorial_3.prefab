  openDialogueAfterQuestAccepted: 0
  openDialogueAfterQuestAcceptedQuestId: 
  oneWayDialogueQueue: 1
  oneWayDialogueQueueSaveId: npc_tutorial_3_merlin
  additionalConditionalDialogues:
  - condition: 1
    completedQuestId: 
    afterDeathRespawnMapNodeId: tutorial_3
    dialogue: 'Sorry about that... i forgot to mention Ivan cant be defeated with
      melee and STAY OUT OF MELEE RANGE! '
    onAcceptOutcome: 0
    teleportTargetNode: {fileID: 0}
    teleportMapNodeId: 
  - condition: 0
    completedQuestId: tutorial_defeat_ivan
    afterDeathRespawnMapNodeId: 
    dialogue: Well done! your job here is complete. Would you like me to send you
      to Duskwood?
    onAcceptOutcome: 1
    teleportTargetNode: {fileID: 11400000, guid: 268f98c476273384a896390c96aa7917, type: 2}
    teleportMapNodeId: duskwood
  questGiver: {fileID: 5839785130135361787}
